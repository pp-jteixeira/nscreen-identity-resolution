-- Complete read-only lookup. Edit the email in params once.
-- All metrics and evidence come from the published pii_clean snapshot.
WITH params AS (
    SELECT lower(trim({{ var('lookup_email_literal', "'person@example.com'") }})) AS input_email
)
SELECT
{{ var('lookup_output_projection') }}
FROM {{ ref('pii_clean') }} r
WHERE lower(trim(r.email)) = (SELECT input_email FROM params)
ORDER BY r.source, r.npi, r.last_seen_day DESC NULLS LAST, r.metric_row_id
